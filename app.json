{
  "expo": {
    "name": "Melo",
    "slug": "melo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "melo",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#ff8a2b",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.melo.chat"
    },
    "android": {
      "package": "app.melo.chat",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 132,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}